---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Manifeste from "../components/Manifeste.astro";
import Essentiels from "../components/Essentiels.astro";
import Reassurance from "../components/Reassurance.astro";
import BandeauCTA from "../components/BandeauCTA.astro";
import Icone from "../components/Icone.astro";
import { Image } from "astro:assets";
import miellerie from "../assets/images/miellerie.jpg";
import { site } from "../data/site";

const temoignages = [
  {
    citation:
      "On a goûté le châtaignier à l'aveugle, à côté de trois miels de grande surface. Il n'y a pas eu de débat. Depuis, c'est le seul miel qu'on sert au restaurant.",
    auteur: "Hélène Dupuy",
    role: "Cheffe, Table du Pilat (Saint-Chamond)",
  },
  {
    citation:
      "Mathieu est venu avec sa ruche vitrée. Vingt-huit CM1 silencieux pendant quarante minutes : je ne l'avais jamais vu de ma carrière.",
    auteur: "Karim Benali",
    role: "Professeur des écoles, Craponne",
  },
  {
    citation:
      "Nos trois ruches d'entreprise sont devenues le sujet de conversation préféré du personnel. Et le bilan biodiversité est entré tel quel dans notre rapport RSE.",
    auteur: "Sophie Marchand",
    role: "Responsable RSE, Groupe Vallier",
  },
];

/* JSON-LD spécifique à la page d'accueil. */
const donneesStructurees = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.nom,
  url: site.url,
  inLanguage: "fr-FR",
  publisher: { "@id": `${site.url}/#organisation` },
};
---

<BaseLayout
  titre="Miels de terroir & ateliers apicoles"
  description="Apiculture artisanale dans les Monts du Lyonnais : miels extraits à froid, produits de la ruche, visites de ruchers et parrainage de ruches. Vente directe du producteur."
  donneesStructurees={donneesStructurees}
>
  <Hero />
  <Manifeste />
  <Essentiels />
  <Reassurance />

  <!-- ============== Bloc miellerie / visite ============== -->
  <section
    class="bg-creme py-20 sm:py-28 lg:py-32"
    aria-labelledby="titre-miellerie"
  >
    <div class="conteneur">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="surtitre">La boutique</p>
          <h2
            id="titre-miellerie"
            class="mt-5 font-display text-h2 font-medium text-anthracite"
          >
            Poussez la porte de la miellerie
          </h2>
          <p class="mt-6 text-lead text-encre">
            Toute la gamme est en vente directe, au prix producteur, dans
            l'ancienne grange que nous avons transformée en laboratoire
            d'extraction. On y goûte avant d'acheter, on y pose toutes les
            questions qu'on veut, et on repart souvent avec un pot de plus que
            prévu.
          </p>

          <dl class="mt-9 grid gap-6 sm:grid-cols-2">
            <div class="flex gap-3.5">
              <Icone nom="horloge" taille={20} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="font-semibold text-anthracite">Horaires</dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-grisdoux">
                  Mercredi → vendredi : 9h30-12h30 / 14h-18h<br />
                  Samedi : 9h-13h
                </dd>
              </div>
            </div>
            <div class="flex gap-3.5">
              <Icone nom="localisation" taille={20} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="font-semibold text-anthracite">Adresse</dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-grisdoux">
                  {site.contact.adresse.ligne2}<br />
                  {site.contact.adresse.codePostal} {site.contact.adresse.ville}
                </dd>
              </div>
            </div>
            <div class="flex gap-3.5">
              <Icone nom="pot-miel" taille={20} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="font-semibold text-anthracite">Consigne</dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-grisdoux">
                  Rapportez vos pots vides : 0,50 € déduits par pot.
                </dd>
              </div>
            </div>
            <div class="flex gap-3.5">
              <Icone nom="voiture" taille={20} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="font-semibold text-anthracite">Accès</dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-grisdoux">
                  25 min de Lyon ouest · parking gratuit · borne de recharge.
                </dd>
              </div>
            </div>
          </dl>

          <div class="mt-10 flex flex-col gap-3.5 sm:flex-row">
            <a href="/contact" class="btn btn-primaire">
              Nous trouver
              <Icone nom="fleche-droite" taille={16} />
            </a>
            <a
              href={`tel:${site.contact.telephone.replace(/\s/g, "")}`}
              class="btn btn-secondaire"
            >
              <Icone nom="telephone" taille={16} />
              {site.contact.telephoneAffiche}
            </a>
          </div>
        </div>

        <figure class="order-first lg:order-last">
          <div class="overflow-hidden rounded-[2rem] shadow-relief sm:rounded-[2.5rem]">
            <Image
              src={miellerie}
              alt="Intérieur de la miellerie : étagères en bois garnies de pots de miel ambrés devant une grande fenêtre, extracteur en inox en arrière-plan."
              widths={[480, 768, 1024]}
              sizes="(min-width: 1024px) 46vw, 100vw"
              loading="lazy"
              class="aspect-4/3 w-full object-cover"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============== Témoignages ============== -->
  <section
    class="bg-sable py-20 sm:py-24"
    aria-labelledby="titre-temoignages"
  >
    <div class="conteneur">
      <header class="mx-auto max-w-2xl text-center">
        <p class="surtitre surtitre-centre">Ils en parlent mieux que nous</p>
        <h2
          id="titre-temoignages"
          class="mt-5 font-display text-h2 font-medium text-anthracite"
        >
          Épiceries, écoles, entreprises
        </h2>
      </header>

      <ul role="list" class="mt-14 grid gap-5 md:grid-cols-3 lg:gap-6">
        {
          temoignages.map((t) => (
            <li class="flex flex-col rounded-2xl border border-cire bg-creme p-7 sm:p-8">
              <span class="font-display text-5xl leading-none text-miel-300" aria-hidden="true">
                «
              </span>
              <blockquote class="mt-3 flex-1 text-[1.0625rem] leading-relaxed text-encre">
                <p>{t.citation}</p>
              </blockquote>
              <footer class="mt-6 border-t border-cire pt-5">
                <p class="font-semibold text-anthracite">{t.auteur}</p>
                <p class="mt-0.5 text-[0.8125rem] text-grisdoux">{t.role}</p>
              </footer>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BandeauCTA
    surtitre="Et si vous adoptiez une ruche ?"
    titre="Parrainez une colonie, recevez son miel"
    texte="Pour les particuliers comme pour les entreprises : votre ruche, votre plaque nominative, vos pots étiquetés et des nouvelles de votre colonie toute l'année. À partir de 95 € par an."
    lienPrincipal={{ libelle: "Découvrir le parrainage", href: "/ateliers-parrainages#parrainage" }}
    lienSecondaire={{ libelle: "Poser une question", href: "/contact" }}
  />
</BaseLayout>
