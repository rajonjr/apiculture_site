---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import EnteteDePage from "../components/EnteteDePage.astro";
import FicheProduit from "../components/FicheProduit.astro";
import BandeauCTA from "../components/BandeauCTA.astro";
import Icone from "../components/Icone.astro";
import miels from "../assets/images/miels-collection.jpg";
import produitsRuche from "../assets/images/produits-ruche.jpg";
import { produits, categories, prixDepuis } from "../data/produits";
import { site as infosSite } from "../data/site";

const visuelsCategorie: Record<string, ImageMetadata | undefined> = {
  miels,
  ruche: produitsRuche,
};

const etapesCommande = [
  {
    icone: "loupe",
    titre: "Vous choisissez",
    texte:
      "Parcourez le catalogue, notez les références qui vous tentent. Tout est à jour : nous mettons le stock à jour chaque lundi matin.",
  },
  {
    icone: "enveloppe",
    titre: "Vous nous écrivez",
    texte:
      "Par le formulaire, par e-mail ou par téléphone. Nous confirmons la disponibilité et le montant exact sous 48 h ouvrées, frais de port inclus.",
  },
  {
    icone: "pot-miel",
    titre: "Vous récupérez",
    texte:
      "Retrait gratuit à la miellerie aux horaires d'ouverture, ou expédition en colis calé avec de la frisure de papier (6,90 € jusqu'à 5 kg, offert dès 70 €).",
  },
] as const;

/* Données structurées : un ItemList de produits, lisible par les moteurs. */
const donneesStructurees = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Catalogue — Rucher des Hautes Bruyères",
    numberOfItems: produits.length,
    itemListElement: produits.map((p, i) => {
      const prix = prixDepuis(p);
      return {
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Product",
          name: p.nom,
          description: p.accroche,
          category: p.categorie,
          brand: { "@type": "Brand", name: infosSite.nom },
          sku: p.conditionnements[0]?.sku,
          ...(prix
            ? {
                offers: {
                  "@type": "AggregateOffer",
                  priceCurrency: "EUR",
                  lowPrice: prix,
                  highPrice: Math.max(
                    ...p.conditionnements.map((c) => c.prix),
                  ),
                  offerCount: p.conditionnements.length,
                  availability:
                    "https://schema.org/InStoreOnly",
                  seller: { "@id": `${infosSite.url}/#organisation` },
                },
              }
            : {}),
        },
      };
    }),
  },
];
---

<BaseLayout
  titre="Nos produits"
  description="Le catalogue complet du Rucher des Hautes Bruyères : sept miels de terroir extraits à froid, gelée royale, pollen frais, propolis, cire, bougies et coffrets. Tarifs et conditionnements."
  donneesStructurees={donneesStructurees}
>
  <EnteteDePage
    surtitre="Le catalogue"
    titre="Tout ce qui sort de nos ruches"
    intro="Sept miels, trois produits de la ruche, de la cire travaillée à la main et quelques gourmandises. Chaque fiche indique la floraison, la période de récolte, les notes de dégustation et le prix au kilo — pour que vous puissiez comparer en connaissance de cause."
    filAriane={[{ libelle: "Accueil", href: "/" }, { libelle: "Nos produits" }]}
  />

  <!-- ============== Navigation par catégorie (collante) ============== -->
  <div
    class="sticky top-[4.5rem] z-30 border-y border-cire bg-creme/92 backdrop-blur-lg sans-impression lg:top-[4.75rem]"
  >
    <nav class="conteneur" aria-label="Catégories de produits">
      <ul
        role="list"
        class="-mx-1 flex snap-x gap-1 overflow-x-auto py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          categories.map((cat) => (
            <li class="snap-start">
              <a
                href={`#${cat.ancre}`}
                class="inline-block whitespace-nowrap rounded-full px-4 py-2 text-[0.875rem] font-medium text-encre transition-colors hover:bg-sable hover:text-anthracite"
              >
                {cat.titre}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- ============== Bandeau « vitrine » ============== -->
  <section class="bg-creme pt-12 sm:pt-16" aria-label="Modalités de commande">
    <div class="conteneur">
      <div
        class="flex flex-col gap-5 rounded-2xl border border-miel-200 bg-miel-50 p-6 sm:flex-row sm:items-center sm:gap-7 sm:p-8"
      >
        <span
          class="grid size-12 shrink-0 place-items-center rounded-xl bg-miel-500/15 text-miel-700"
          aria-hidden="true"
        >
          <Icone nom="info" taille={24} />
        </span>
        <div class="flex-1">
          <h2 class="font-display text-h3 text-anthracite">
            Pas encore de paiement en ligne — et c'est volontaire
          </h2>
          <p class="mt-2 max-w-3xl text-[0.9375rem] leading-relaxed text-encre">
            Nous préférons confirmer chaque commande à la main : nos stocks sont
            petits, saisonniers, et certaines récoltes partent en quelques jours.
            La boutique en ligne ouvrira au printemps 2027, une fois le volume
            stabilisé. D'ici là, écrivez-nous : nous répondons sous 48 h.
          </p>
        </div>
        <a href="/contact" class="btn btn-primaire shrink-0">
          Passer commande
          <Icone nom="fleche-droite" taille={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============== Catalogue par catégorie ============== -->
  {
    categories.map((categorie, index) => {
      const liste = produits.filter((p) => p.categorie === categorie.id);
      const visuel = visuelsCategorie[categorie.id];
      return (
        <section
          id={categorie.ancre}
          class:list={[
            "scroll-mt-32 py-16 sm:py-20",
            index % 2 === 0 ? "bg-creme" : "bg-sable",
          ]}
          aria-labelledby={`titre-${categorie.ancre}`}
        >
          <div class="conteneur">
            <header class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
              <div class="lg:col-span-7">
                <p class="surtitre">
                  {String(index + 1).padStart(2, "0")} — {liste.length} référence
                  {liste.length > 1 ? "s" : ""}
                </p>
                <h2
                  id={`titre-${categorie.ancre}`}
                  class="mt-5 font-display text-h2 font-medium text-anthracite"
                >
                  {categorie.titre}
                </h2>
                <p class="mt-4 max-w-2xl text-lead text-encre">
                  {categorie.intro}
                </p>
              </div>

              {visuel && (
                <figure class="lg:col-span-5">
                  <div class="overflow-hidden rounded-2xl shadow-douce">
                    <Image
                      src={visuel}
                      alt={
                        categorie.id === "miels"
                          ? "Trois pots de miel artisanaux aux teintes différentes — doré clair, ambre et brun foncé — posés sur une nappe de lin, à côté d'un rayon de cire."
                          : "Bougies en cire d'abeille, flacon de propolis, coupelle de pollen multicolore et pot de gelée royale disposés sur un plan clair."
                      }
                      widths={[400, 640, 900]}
                      sizes="(min-width: 1024px) 38vw, 100vw"
                      loading="lazy"
                      class="aspect-16/9 w-full object-cover"
                    />
                  </div>
                </figure>
              )}
            </header>

            <div class="mt-12 space-y-5 lg:space-y-6">
              {liste.map((produit) => (
                <FicheProduit produit={produit} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- ============== Comment commander ============== -->
  <section
    class="bg-creme py-20 sm:py-24"
    aria-labelledby="titre-commander"
  >
    <div class="conteneur">
      <header class="mx-auto max-w-2xl text-center">
        <p class="surtitre surtitre-centre">Mode d'emploi</p>
        <h2
          id="titre-commander"
          class="mt-5 font-display text-h2 font-medium text-anthracite"
        >
          Commander en trois temps
        </h2>
      </header>

      <ol role="list" class="mt-14 grid gap-5 md:grid-cols-3 lg:gap-6">
        {
          etapesCommande.map((etape, i) => (
            <li class="relative rounded-2xl border border-cire bg-sable p-7 sm:p-8">
              <span
                class="absolute right-7 top-7 font-display text-5xl font-medium leading-none text-miel-300"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <span
                class="grid size-12 place-items-center rounded-xl bg-creme text-miel-700"
                aria-hidden="true"
              >
                <Icone nom={etape.icone} taille={23} />
              </span>
              <h3 class="mt-5 font-display text-h3 text-anthracite">
                {etape.titre}
              </h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-encre">
                {etape.texte}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============== Professionnels ============== -->
  <section
    id="professionnels"
    class="relative scroll-mt-32 overflow-hidden bg-sapin-900 py-20 text-creme sm:py-24"
    aria-labelledby="titre-pros"
  >
    <div
      class="trame-alveoles pointer-events-none absolute inset-0 opacity-[0.07]"
      aria-hidden="true"
    >
    </div>

    <div class="conteneur relative grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="surtitre text-miel-300!">Épiceries fines & restaurants</p>
        <h2
          id="titre-pros"
          class="mt-5 font-display text-h2 font-medium text-creme"
        >
          Revendre nos miels dans votre boutique
        </h2>
        <p class="mt-6 text-[1.0625rem] leading-relaxed text-creme/75">
          Nous travaillons avec une vingtaine d'épiceries fines, fromageries et
          restaurants entre Lyon et Saint-Étienne. Le principe est simple :
          dépôt-vente ou achat ferme, tarif dégressif, livraison par nos soins
          dans un rayon de soixante kilomètres, et une fiche produit complète
          pour que votre équipe sache en parler.
        </p>

        <ul role="list" class="mt-8 space-y-3.5">
          {
            [
              "Remise de 35 % sur le tarif public dès 40 pots par commande",
              "Franco de port à partir de 250 € HT",
              "PLV offerte : chevalets, fiches de dégustation, affiche A2",
              "Étiquetage conforme (lot, DDM, origine France, allergènes)",
              "Possibilité d'étiquette co-brandée dès 120 pots",
            ].map((item) => (
              <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-creme/80">
                <Icone nom="check" taille={18} classe="mt-0.5 shrink-0 text-miel-300" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <a href="/contact#professionnels" class="btn btn-miel mt-10">
          Demander le tarif professionnel
          <Icone nom="fleche-droite" taille={16} />
        </a>
      </div>

      <div class="rounded-2xl border border-creme/12 bg-creme/5 p-7 sm:p-9">
        <h3 class="font-display text-h3 text-creme">Capacités de production</h3>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-creme/70">
          Nous sommes une petite exploitation : mieux vaut connaître les volumes
          avant de s'engager.
        </p>

        <dl class="mt-8 space-y-5">
          {
            [
              { k: "Récolte annuelle moyenne", v: "3,2 tonnes" },
              { k: "Volume disponible en gros", v: "≈ 900 kg / an" },
              { k: "Délai de réassort", v: "5 à 10 jours ouvrés" },
              { k: "Commande minimale professionnelle", v: "40 pots" },
              { k: "Agrément sanitaire", v: "FR 69.231.001 CE" },
            ].map((ligne) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-creme/12 pb-4 last:border-0 last:pb-0">
                <dt class="text-[0.9375rem] text-creme/70">{ligne.k}</dt>
                <dd class="shrink-0 text-right font-display text-lg text-creme">
                  {ligne.v}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <BandeauCTA
    surtitre="Une question sur un miel ?"
    titre="Dites-nous ce que vous aimez, nous vous orienterons"
    texte="Plutôt doux ou plutôt corsé ? Pour la tartine ou pour la cuisine ? Un message suffit — et si vous passez à la miellerie, vous goûterez tout avant de choisir."
    lienPrincipal={{ libelle: "Nous écrire", href: "/contact" }}
    lienSecondaire={{ libelle: "Voir les points de vente", href: "/contact#points-de-vente" }}
  />
</BaseLayout>
