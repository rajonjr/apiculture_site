---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnteteDePage from "../components/EnteteDePage.astro";
import { site } from "../data/site";

const sommaire = [
  { id: "editeur", libelle: "Éditeur du site" },
  { id: "hebergement", libelle: "Hébergement" },
  { id: "propriete", libelle: "Propriété intellectuelle" },
  { id: "donnees", libelle: "Données personnelles & cookies" },
  { id: "cgv", libelle: "Conditions de vente" },
  { id: "accessibilite", libelle: "Accessibilité" },
  { id: "ecoconception", libelle: "Écoconception" },
];
---

<BaseLayout
  titre="Mentions légales"
  description="Mentions légales, politique de confidentialité, conditions de vente, déclaration d'accessibilité et démarche d'écoconception du site du Rucher des Hautes Bruyères."
>
  <EnteteDePage
    surtitre="Informations légales"
    titre="Mentions légales & confidentialité"
    intro="Tout ce que la loi nous demande d'afficher, et quelques informations qu'elle ne demande pas mais qui nous paraissent utiles."
    filAriane={[{ libelle: "Accueil", href: "/" }, { libelle: "Mentions légales" }]}
  />

  <section class="bg-creme pb-24">
    <div class="conteneur grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Sommaire -->
      <nav class="lg:col-span-3" aria-label="Sommaire de la page">
        <div class="lg:sticky lg:top-28">
          <h2 class="text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-grisdoux">
            Sommaire
          </h2>
          <ul role="list" class="mt-4 space-y-2 border-l border-cire">
            {
              sommaire.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    class="-ml-px block border-l-2 border-transparent py-1 pl-4 text-[0.9375rem] text-encre transition-colors hover:border-miel-500 hover:text-miel-700"
                  >
                    {s.libelle}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <div class="lg:col-span-9">
        <div class="prose-miel text-base!">
          <section id="editeur" class="scroll-mt-28">
            <h2 class="mt-0!">Éditeur du site</h2>
            <p>
              <strong>{site.nom}</strong> — exploitation agricole individuelle.<br />
              {site.contact.adresse.ligne2}, {site.contact.adresse.codePostal}
              {site.contact.adresse.ville}, France.<br />
              SIRET : {site.siret} · TVA intracommunautaire : {site.tva} ·
              APE 0149Z (élevage d'autres animaux).<br />
              Agrément sanitaire : FR 69.231.001 CE · NAPI (numéro d'apiculteur) : 69-01234.
            </p>
            <p>
              Directeur de la publication : {site.apiculteurs.principal}.<br />
              Contact : <a href={`mailto:${site.contact.email}`} class="lien-souligne">{site.contact.email}</a>
              · {site.contact.telephoneAffiche}.
            </p>
          </section>

          <section id="hebergement" class="scroll-mt-28">
            <h2>Hébergement</h2>
            <p>
              Le site est hébergé par un prestataire situé en France, alimenté
              en électricité d'origine renouvelable. Les pages étant générées
              statiquement, aucune base de données n'est interrogée lors de
              votre visite.
            </p>
            <p class="text-[0.9375rem] text-grisdoux">
              <em>
                À compléter avant mise en ligne : raison sociale, adresse et
                téléphone de l'hébergeur (mention obligatoire — article 6 III
                de la LCEN).
              </em>
            </p>
          </section>

          <section id="propriete" class="scroll-mt-28">
            <h2>Propriété intellectuelle</h2>
            <p>
              L'ensemble des contenus de ce site — textes, photographies,
              illustrations, identité visuelle, code source — est la propriété
              exclusive du {site.nom}, sauf mention contraire. Toute
              reproduction, même partielle, est soumise à autorisation écrite
              préalable.
            </p>
            <p>
              Les photographies de presse sont disponibles gratuitement pour les
              journalistes et les enseignants, sur simple demande.
            </p>
          </section>

          <section id="donnees" class="scroll-mt-28">
            <h2>Données personnelles & cookies</h2>

            <h3>Ce que nous collectons</h3>
            <p>
              Uniquement ce que vous nous donnez volontairement via le
              formulaire de contact (nom, prénom, adresse e-mail, téléphone,
              structure, contenu du message) ou le formulaire d'inscription à la
              lettre d'information (adresse e-mail).
            </p>

            <h3>Pourquoi, et pour combien de temps</h3>
            <ul role="list" class="space-y-2.5">
              <li class="flex gap-3">
                <span class="text-miel-600" aria-hidden="true">·</span>
                <span>
                  <strong>Répondre à votre demande</strong> — base légale :
                  intérêt légitime. Conservation : 3 ans à compter du dernier
                  contact.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="text-miel-600" aria-hidden="true">·</span>
                <span>
                  <strong>Vous envoyer la lettre saisonnière</strong> — base
                  légale : votre consentement. Conservation : jusqu'à votre
                  désinscription, possible en un clic dans chaque envoi.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="text-miel-600" aria-hidden="true">·</span>
                <span>
                  <strong>Obligations comptables</strong> (factures) — base
                  légale : obligation légale. Conservation : 10 ans.
                </span>
              </li>
            </ul>

            <h3>Cookies et traceurs</h3>
            <p>
              <strong>Ce site ne dépose aucun cookie.</strong> Pas de cookie de
              mesure d'audience, pas de pixel publicitaire, pas de bouton de
              réseau social traçant. C'est aussi pour cela que vous n'avez pas
              eu de bandeau à refuser en arrivant.
            </p>
            <p>
              Les polices de caractères sont hébergées sur notre propre serveur
              (aucun appel à Google Fonts). La carte de localisation
              OpenStreetMap n'est chargée que si vous cliquez explicitement sur
              le bouton prévu à cet effet : tant que vous ne le faites pas,
              aucune donnée n'est transmise à un tiers.
            </p>

            <h3>Vos droits</h3>
            <p>
              Conformément au RGPD et à la loi « Informatique et Libertés »,
              vous disposez d'un droit d'accès, de rectification, d'effacement,
              de limitation, d'opposition et de portabilité de vos données.
              Écrivez-nous à
              <a href={`mailto:${site.contact.email}`} class="lien-souligne">{site.contact.email}</a> :
              nous répondons sous un mois. En cas de désaccord, vous pouvez
              saisir la CNIL (3 place de Fontenoy, 75007 Paris —
              <a href="https://www.cnil.fr" rel="noopener noreferrer" target="_blank" class="lien-souligne">cnil.fr</a>).
            </p>
          </section>

          <section id="cgv" class="scroll-mt-28">
            <h2>Conditions de vente</h2>
            <p>
              Ce site est un <strong>site vitrine</strong> : aucune transaction
              ni aucun paiement n'y est réalisé. Les prix affichés sont
              indicatifs, exprimés en euros toutes taxes comprises, et
              susceptibles d'évoluer selon les récoltes.
            </p>
            <p>
              Les ventes se concluent en direct à la miellerie, sur les marchés,
              ou par commande confirmée par e-mail ou par téléphone. Les tarifs
              professionnels font l'objet d'un devis distinct en HT.
            </p>
            <p>
              Conformément à la réglementation, le miel vendu est d'origine
              France et son origine florale est garantie par analyse
              pollinique pour les miels monofloraux. La date de durabilité
              minimale figure sur chaque pot. Le miel est déconseillé aux
              enfants de moins de douze mois.
            </p>
            <p class="text-[0.9375rem] text-grisdoux">
              <em>
                À compléter lors de l'ouverture de la vente en ligne : CGV
                complètes, droit de rétractation de 14 jours, modalités de
                remboursement, médiateur de la consommation.
              </em>
            </p>
          </section>

          <section id="accessibilite" class="scroll-mt-28">
            <h2>Déclaration d'accessibilité</h2>
            <p>
              Nous visons la conformité au RGAA 4.1 (niveau AA). Le site est à
              ce jour <strong>partiellement conforme</strong> : l'audit complet
              n'a pas encore été réalisé par un organisme tiers.
            </p>
            <p>Mesures déjà en place :</p>
            <ul role="list" class="space-y-2">
              {
                [
                  "Structure sémantique complète (titres hiérarchisés, repères ARIA, listes).",
                  "Contrastes vérifiés : texte courant à 10,5:1, texte secondaire à 4,65:1.",
                  "Navigation intégrale au clavier avec indicateur de focus visible.",
                  "Lien d'évitement vers le contenu principal.",
                  "Textes alternatifs rédigés pour toutes les images informatives.",
                  "Animations désactivées si « réduire les animations » est activé sur votre appareil.",
                  "Aucun contenu dépendant uniquement de la couleur ou du survol.",
                ].map((item) => (
                  <li class="flex gap-3">
                    <span class="text-miel-600" aria-hidden="true">·</span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <p>
              Vous rencontrez un obstacle ? Signalez-le à
              <a href={`mailto:${site.contact.email}`} class="lien-souligne">{site.contact.email}</a> :
              nous corrigerons, et nous vous transmettrons entre-temps
              l'information par un autre moyen.
            </p>
          </section>

          <section id="ecoconception" class="scroll-mt-28">
            <h2>Démarche d'écoconception</h2>
            <p>
              Un site web consomme de l'énergie à chaque visite. Nous avons
              essayé d'en consommer le moins possible, avec les mêmes réflexes
              qu'au rucher : ne prendre que le nécessaire.
            </p>
            <ul role="list" class="space-y-2">
              {
                [
                  "Pages 100 % statiques : aucun calcul serveur ni requête en base à chaque visite.",
                  "Images converties en AVIF et WebP, redimensionnées pour chaque taille d'écran et chargées à la demande.",
                  "Deux polices variables auto-hébergées (114 Ko au total) plutôt que six fichiers statiques.",
                  "Icônes en SVG inline : aucune police d'icônes, aucune requête supplémentaire.",
                  "Moins de 10 Ko de JavaScript sur l'ensemble du site, et aucune bibliothèque tierce.",
                  "Carte géographique chargée uniquement sur action volontaire (environ 500 Ko économisés).",
                  "Aucun outil de mesure d'audience, aucun traceur publicitaire, aucun cookie.",
                  "Hébergement en France sur une infrastructure alimentée en électricité renouvelable.",
                ].map((item) => (
                  <li class="flex gap-3">
                    <span class="text-sapin-600" aria-hidden="true">·</span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <p>
              Le plus simple reste encore de ne pas venir : si vous habitez à
              côté, poussez directement la porte de la miellerie.
            </p>
          </section>

          <p class="mt-14 border-t border-cire pt-7 text-[0.875rem] text-grisdoux">
            Dernière mise à jour : octobre 2026.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
