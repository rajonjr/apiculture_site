---
import Logo from "./Logo.astro";
import Icone from "./Icone.astro";
import { site, liensPied, formulaires } from "../data/site";

const annee = new Date().getFullYear();

const colonnes = [
  { titre: "Découvrir", liens: liensPied.decouvrir },
  { titre: "Acheter", liens: liensPied.acheter },
  { titre: "Participer", liens: liensPied.participer },
] as const;

const iconesReseaux = {
  Instagram: "instagram",
  Facebook: "facebook",
  LinkedIn: "linkedin",
} as const;
---

<footer class="relative mt-24 overflow-hidden bg-sapin-900 text-creme/75 sm:mt-32">
  <!-- Trame d'alvéoles décorative -->
  <div
    class="trame-alveoles pointer-events-none absolute inset-0 opacity-[0.07]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-miel-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="conteneur relative">
    <!-- Bloc lettre d'information -->
    <section
      class="grid gap-8 border-b border-creme/12 py-14 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-16 sm:py-16"
      aria-labelledby="titre-infolettre"
    >
      <div>
        <h2
          id="titre-infolettre"
          class="font-display text-h3 text-creme"
        >
          Les nouvelles du rucher, quatre fois par an
        </h2>
        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
          Une lettre par saison : ce que les abeilles rapportent, les récoltes
          disponibles, les dates d'ateliers. Pas de promotion agressive, pas de
          revente de vos données, désinscription en un clic.
        </p>
      </div>

      <form
        class="flex flex-col gap-3"
        name="infolettre"
        method="post"
        action={formulaires.endpoint || formulaires.pageConfirmation}
        data-endpoint={formulaires.endpoint}
        data-confirmation={formulaires.pageConfirmation}
        data-formulaire-infolettre
      >
        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="flex-1">
            <label for="courriel-infolettre" class="sr-only">
              Votre adresse e-mail
            </label>
            <input
              id="courriel-infolettre"
              type="email"
              name="email"
              autocomplete="email"
              required
              placeholder="prenom@exemple.fr"
              class="w-full rounded-full border border-creme/25 bg-creme/8 px-5 py-3.5 text-[0.9375rem] text-creme placeholder:text-creme/45 focus:border-miel-300 focus:outline-none focus:ring-2 focus:ring-miel-300/35"
            />
          </div>
          <button type="submit" class="btn btn-miel shrink-0">
            Je m'abonne
          </button>
        </div>
        <p class="text-xs leading-relaxed text-creme/55">
          En vous inscrivant, vous acceptez de recevoir notre lettre saisonnière.
          Vos données sont hébergées en France et ne sont jamais cédées à des
          tiers. <a href="/mentions-legales#donnees" class="underline underline-offset-2 hover:text-creme">En savoir plus</a>.
        </p>
      </form>
    </section>

    <!-- Colonnes de liens -->
    <div class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)] lg:gap-12 sm:py-16">
      <div>
        <Logo variante="clair" />
        <p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed">
          {site.nom} — {site.baseline}. {site.contact.adresse.region}.
        </p>

        <address class="mt-6 space-y-2.5 text-[0.9375rem] not-italic">
          <p class="flex items-start gap-2.5">
            <Icone nom="localisation" taille={17} classe="mt-0.5 shrink-0 text-miel-300" />
            <span>
              {site.contact.adresse.ligne2}<br />
              {site.contact.adresse.codePostal}
              {site.contact.adresse.ville}
            </span>
          </p>
          <p class="flex items-center gap-2.5">
            <Icone nom="telephone" taille={17} classe="shrink-0 text-miel-300" />
            <a
              href={`tel:${site.contact.telephone.replace(/\s/g, "")}`}
              class="transition-colors hover:text-creme"
            >
              {site.contact.telephoneAffiche}
            </a>
          </p>
          <p class="flex items-center gap-2.5">
            <Icone nom="enveloppe" taille={17} classe="shrink-0 text-miel-300" />
            <a
              href={`mailto:${site.contact.email}`}
              class="break-all transition-colors hover:text-creme"
            >
              {site.contact.email}
            </a>
          </p>
        </address>

        <ul role="list" class="mt-7 flex items-center gap-2.5">
          {
            site.reseaux.map((reseau) => (
              <li>
                <a
                  href={reseau.url}
                  rel="noopener noreferrer me"
                  target="_blank"
                  class="inline-flex size-10 items-center justify-center rounded-full border border-creme/20 text-creme/80 transition-colors hover:border-miel-300 hover:bg-miel-500/15 hover:text-creme"
                >
                  <span class="sr-only">
                    {reseau.nom} — {reseau.handle} (nouvelle fenêtre)
                  </span>
                  <Icone
                    nom={iconesReseaux[reseau.nom as keyof typeof iconesReseaux]}
                    taille={18}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        colonnes.map((colonne) => (
          <nav aria-label={colonne.titre}>
            <h2 class="font-sans text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-miel-300">
              {colonne.titre}
            </h2>
            <ul role="list" class="mt-5 space-y-3">
              {colonne.liens.map((lien) => (
                <li>
                  <a
                    href={lien.href}
                    class="text-[0.9375rem] transition-colors hover:text-creme"
                  >
                    {lien.libelle}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Labels & certifications -->
    <div
      class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-creme/12 py-6 text-[0.8125rem]"
    >
      <span class="font-semibold uppercase tracking-[0.14em] text-miel-300 text-[0.6875rem]">
        Nos engagements
      </span>
      {
        site.certifications.map((label) => (
          <span class="inline-flex items-center gap-2">
            <Icone nom="check" taille={15} classe="text-miel-300" />
            {label}
          </span>
        ))
      }
      <span class="inline-flex items-center gap-2">
        <Icone nom="feuille" taille={15} classe="text-miel-300" />
        Site écoconçu, hébergé en France sur énergie renouvelable
      </span>
    </div>

    <!-- Mentions -->
    <div
      class="flex flex-col gap-4 border-t border-creme/12 py-7 text-[0.8125rem] text-creme/55 md:flex-row md:items-center md:justify-between"
    >
      <p>
        © {annee} {site.nom} — SIRET {site.siret}. Tous droits réservés.
      </p>
      <ul role="list" class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          liensPied.legal.map((lien) => (
            <li>
              <a href={lien.href} class="transition-colors hover:text-creme">
                {lien.libelle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="pb-8 text-xs leading-relaxed text-creme/40">
      L'abus d'alcool est dangereux pour la santé, à consommer avec modération.
      Les produits de la ruche ne sont pas des médicaments et ne se substituent
      pas à un avis médical. Le miel est déconseillé aux enfants de moins de
      douze mois.
    </p>
  </div>
</footer>

<script>
  /* Infolettre : même logique que le formulaire de contact. Sans point de
     terminaison configuré, on redirige vers la page de confirmation. */
  const infolettre = document.querySelector<HTMLFormElement>(
    "[data-formulaire-infolettre]",
  );

  infolettre?.addEventListener("submit", (e) => {
    const champ = infolettre.querySelector<HTMLInputElement>("input[type=email]");
    if (champ && !champ.checkValidity()) return; // validation native

    e.preventDefault();
    const endpoint = infolettre.dataset.endpoint;
    const confirmation = infolettre.dataset.confirmation || "/merci";

    if (!endpoint) {
      window.location.assign(confirmation);
      return;
    }

    fetch(endpoint, {
      method: "POST",
      headers: { Accept: "application/json" },
      body: new FormData(infolettre),
    })
      .then(() => window.location.assign(confirmation))
      .catch(() => window.location.assign(confirmation));
  });
</script>
