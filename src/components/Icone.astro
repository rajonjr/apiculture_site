  nom,
  taille = 24,
  classe = "",
  epaisseur = 1.6,
  titre,
  "aria-hidden": ariaHidden = !titre,
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={epaisseur}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classe}
  aria-hidden={ariaHidden ? "true" : undefined}
  role={titre ? "img" : undefined}
  focusable="false"
  set:html={(titre ? `<title>${titre}</title>` : "") + chemins[nom]}
/>
