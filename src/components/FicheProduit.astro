---
import Icone from "./Icone.astro";
import {
  formaterPrix,
  prixAuKilo,
  libellesDisponibilite,
  type Produit,
} from "../data/produits";

interface Props {
  produit: Produit;
}

const { produit } = Astro.props;
---

<article
  id={produit.slug}
  class="scroll-mt-32 overflow-hidden rounded-2xl border border-cire bg-creme transition-colors duration-500 hover:border-miel-300 md:grid md:grid-cols-12"
>
  <!-- Nuancier : la teinte réelle du produit, sans aucune image -->
  <div
    class="relative h-36 overflow-hidden md:col-span-4 md:h-full md:min-h-[17rem] lg:col-span-3"
    style={`background-image: radial-gradient(130% 120% at 30% 15%, ${produit.teinte?.clair ?? "#f4d99f"} 0%, ${produit.teinte?.fonce ?? "#8c5513"} 80%);`}
  >
    <div
      class="trame-alveoles-fine absolute inset-0 opacity-25 mix-blend-overlay"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-12 -right-8 size-40 rounded-full bg-white/15 blur-2xl"
      aria-hidden="true"
    >
    </div>

    {
      produit.etiquette && (
        <span
          class={`etiquette absolute left-4 top-4 etiquette-${produit.etiquette.ton}`}
        >
          {produit.etiquette.texte}
        </span>
      )
    }

    <span class="absolute bottom-4 right-4 text-white/80">
      <Icone
        nom={produit.categorie === "cire"
          ? "bougie"
          : produit.categorie === "coffrets"
            ? "cadeau"
            : produit.categorie === "ruche"
              ? "goutte"
              : "pot-miel"}
        taille={28}
        epaisseur={1.3}
      />
    </span>
  </div>

  <!-- Contenu -->
  <div class="p-6 sm:p-8 md:col-span-8 lg:col-span-9">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="max-w-2xl">
        <h3 class="font-display text-h3 font-medium text-anthracite">
          {produit.nom}
        </h3>
        <p class="mt-2 text-[1.0625rem] font-medium italic text-miel-700">
          {produit.accroche}
        </p>
      </div>
    </div>

    <p class="mt-5 max-w-3xl leading-relaxed text-encre">
      {produit.description}
    </p>

    <!-- Caractéristiques -->
    {
      (produit.recolte || produit.texture || produit.accords || produit.bienfaits) && (
        <dl class="mt-7 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {produit.recolte && (
            <div class="flex gap-3">
              <Icone nom="calendrier" taille={17} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-grisdoux">
                  Récolte
                </dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-encre">
                  {produit.recolte}
                </dd>
              </div>
            </div>
          )}
          {produit.texture && (
            <div class="flex gap-3">
              <Icone nom="goutte" taille={17} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-grisdoux">
                  Texture
                </dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-encre">
                  {produit.texture}
                </dd>
              </div>
            </div>
          )}
          {produit.accords && (
            <div class="flex gap-3">
              <Icone nom="etoile" taille={17} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-grisdoux">
                  Accords
                </dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-encre">
                  {produit.accords}
                </dd>
              </div>
            </div>
          )}
          {produit.bienfaits && (
            <div class="flex gap-3">
              <Icone nom="feuille" taille={17} classe="mt-0.5 shrink-0 text-miel-600" />
              <div>
                <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-grisdoux">
                  Bon à savoir
                </dt>
                <dd class="mt-1 text-[0.9375rem] leading-relaxed text-encre">
                  {produit.bienfaits}
                </dd>
              </div>
            </div>
          )}
        </dl>
      )
    }

    <!-- Notes de dégustation -->
    {
      produit.notesDegustation && (
        <div class="mt-7">
          <p class="text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-grisdoux">
            Notes de dégustation
          </p>
          <ul role="list" class="mt-2.5 flex flex-wrap gap-1.5">
            {produit.notesDegustation.map((note) => (
              <li class="rounded-full border border-cire bg-sable px-3 py-1 text-[0.75rem] font-medium text-encre">
                {note}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Conditionnements & tarifs -->
    <div class="mt-8 overflow-hidden rounded-xl border border-cire">
      <table class="w-full border-collapse text-left text-[0.9375rem]">
        <caption class="sr-only">
          Conditionnements et tarifs — {produit.nom}
        </caption>
        <thead>
          <tr class="bg-sable text-[0.6875rem] uppercase tracking-[0.12em] text-grisdoux">
            <th scope="col" class="px-4 py-2.5 font-bold sm:px-5">Conditionnement</th>
            <th scope="col" class="px-4 py-2.5 text-right font-bold sm:px-5">Prix TTC</th>
            <th scope="col" class="hidden px-5 py-2.5 text-right font-bold sm:table-cell">
              Prix au kilo
            </th>
            <th scope="col" class="px-4 py-2.5 text-right font-bold sm:px-5">Stock</th>
          </tr>
        </thead>
        <tbody>
          {
            produit.conditionnements.map((c) => {
              const dispo = libellesDisponibilite[c.disponibilite];
              return (
                <tr class="border-t border-cire/70" data-sku={c.sku}>
                  <th scope="row" class="px-4 py-3.5 font-medium text-anthracite sm:px-5">
                    {c.libelle}
                  </th>
                  <td class="whitespace-nowrap px-4 py-3.5 text-right font-display text-base font-medium text-anthracite tabular-nums sm:px-5">
                    {c.prix > 0 ? formaterPrix(c.prix) : "Sur devis"}
                  </td>
                  <td class="hidden whitespace-nowrap px-5 py-3.5 text-right text-grisdoux tabular-nums sm:table-cell">
                    {prixAuKilo(c) ?? "—"}
                  </td>
                  <td class="px-4 py-3.5 text-right sm:px-5">
                    <span class={`etiquette etiquette-${dispo.ton}`}>
                      {dispo.texte}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <!-- Action (vitrine : pas de paiement en ligne pour l'instant) -->
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        href={`/contact?produit=${produit.slug}`}
        class="btn btn-secondaire py-3! text-sm!"
        data-action-commande
        data-sku={produit.conditionnements[0]?.sku}
      >
        <Icone nom="enveloppe" taille={16} />
        Commander ce produit
      </a>
      <p class="text-[0.8125rem] text-grisdoux">
        Retrait à la miellerie ou expédition en France métropolitaine.
      </p>
    </div>
  </div>
</article>
